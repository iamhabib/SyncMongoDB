MONGO_DATABASE_NAME=abc

# Local MongoDB Config (required — no insecure defaults)
LOCAL_MONGO_PORT=27017
LOCAL_MONGO_ROOT_USER=admin
LOCAL_MONGO_ROOT_PASSWORD=your_secure_root_password

# MongoDB connection strings (source is read via Change Streams; must be a replica set / Atlas)
REMOTE_MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/{MONGO_DATABASE_NAME}?retryWrites=true&w=majority
LOCAL_MONGO_URL=mongodb://{LOCAL_MONGO_ROOT_USER}:{LOCAL_MONGO_ROOT_PASSWORD}@localhost:{LOCAL_MONGO_PORT}/{MONGO_DATABASE_NAME}?authSource=admin

# --- Service tuning (safe defaults, override if needed) ---
MONGO_IMAGE=mongo:7
PORT=3000
HEALTH_BIND_HOST=127.0.0.1
LOG_LEVEL=info
MAX_RETRIES=10
RETRY_DELAY_MS=5000
DISCOVERY_INTERVAL_MS=60000
DIVERGENCE_CHECK_INTERVAL_MS=21600000
# When true, collections with count drift >= threshold are dropped locally and fully re-synced
AUTO_REPAIR_ON_DIVERGENCE=false
DIVERGENCE_REPAIR_THRESHOLD=1
# Set true to log each replicated INSERT/UPDATE/DELETE at info (use with monitor.sh option 7)
LOG_REPLICATION_EVENTS=false
