# --- Required ---
MONGO_DATABASE_NAME=abc

# Must be unique on this EC2 across /var/www/db-* installs
LOCAL_MONGO_PORT=27018
SYNC_AGENT_PORT=3001

LOCAL_MONGO_ROOT_USER=admin
LOCAL_MONGO_ROOT_PASSWORD=your_secure_root_password

# Atlas / remote source (replica set required for Change Streams)
REMOTE_MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/{MONGO_DATABASE_NAME}?retryWrites=true&w=majority

# --- Optional (safe defaults; override only if needed) ---

# Log each replicated INSERT/UPDATE/DELETE at info (monitor.sh option 7)
LOG_REPLICATION_EVENTS=false

# Winston log level: debug | info | warn | error
LOG_LEVEL=info

# Bind address for /health and /metrics inside the container (Compose sets 0.0.0.0)
HEALTH_BIND_HOST=127.0.0.1

# Change-stream retry behavior
MAX_RETRIES=10
RETRY_DELAY_MS=5000

# How often to discover new remote collections (ms)
DISCOVERY_INTERVAL_MS=60000

# How often to compare counts + sync indexes (ms). Default 6 hours.
DIVERGENCE_CHECK_INTERVAL_MS=21600000

# If true, drop+re-sync local collections when |remote−local| count >= threshold
AUTO_REPAIR_ON_DIVERGENCE=false
DIVERGENCE_REPAIR_THRESHOLD=1

# Only for non-Compose / local node runs. Compose overrides this to mongo:27017.
# LOCAL_MONGO_URL=mongodb://admin:password@localhost:27018/abc?authSource=admin
